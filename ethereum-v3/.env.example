# ============================================
# Ethereum V3 - Environment Configuration
# ============================================

# Sepolia RPC URL (Alchemy, Infura, or public)
SEPOLIA_RPC_URL=https://your-sepolia-rpc-url

# Deployer wallet private key (TESTNET ONLY)
# NEVER use a mainnet wallet or real funds
DEPLOYER_PRIVATE_KEY=your-testnet-wallet-private-key

# Etherscan API key for contract verification
# Get at: https://etherscan.io/apis
ETHERSCAN_API_KEY=your-etherscan-api-key

# Optional: CoinMarketCap API for gas price in USD
# Get at: https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=your-coinmarketcap-api-key

# Gas reporting
REPORT_GAS=false
GAS_REPORT_FILE=gas-report.txt

# ============================================
# Security Notes
# ============================================
# - This .env file contains secrets
# - NEVER commit it to git
# - ALWAYS use .gitignore to exclude it
# - Use a dedicated testnet wallet only
# ============================================

# ============================================
# Portfolio demo environment (Milestone 1)
# ============================================

# BIP-39 mnemonic for the controlled Sepolia demo participant wallets.
# TESTNET ONLY. EthSplit.join() is msg.sender-based and the manager cannot join,
# so demo participants must sign their own transactions.
# Generate a throwaway phrase, never reuse a real wallet, never commit it:
#   node -e "console.log(require('ethers').Wallet.createRandom().mnemonic.phrase)"
DEMO_MNEMONIC=

# Optional: override the public RPC the frontend reads from at build time.
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
