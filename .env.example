# Public browser configuration. Next.js injects these values at build time.

NEXT_PUBLIC_WEB3_API_URL=https://web3-api.example.com

# How often the console refreshes itself, in milliseconds.
#
# One request per refresh, against /api/v1/web3/dashboard, answered from the
# backend's shared snapshot cache. Clamped to 30000-600000; anything outside
# that, or unparseable, falls back to the 90000 default. Nothing on this page
# changes quickly — it is a fixed testnet demo — and the previous 15s poll
# against three endpoints at once is what turned an RPC rate limit into an
# unreachable dashboard.
NEXT_PUBLIC_WEB3_REFRESH_MS=90000
