# PostgreSQL — local Docker development only
DATABASE_URL=postgresql://web3:web3_local_dev_only@127.0.0.1:55432/web3_index_dev?schema=public
DATABASE_URL_TEST=postgresql://web3:web3_local_dev_only@127.0.0.1:55432/web3_index_test?schema=public

# Server-side RPC. Replace the placeholder locally. This is a server secret:
# never put it in the frontend build environment, where NEXT_PUBLIC_* values are
# compiled into the bundle every visitor downloads.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Public Sepolia demo deployment
WEB3_FACTORY_ADDRESS=0xbddD01aE6B2899c507DD540E6437552006f008eA
WEB3_FACTORY_DEPLOYMENT_BLOCK=11585248

# --- RPC transport ----------------------------------------------------------
# Ethers defaults to a 300s request timeout and twelve retries on a 429, which
# is how a rate limit became a 504: one getBlockNumber took 248 seconds while
# Nginx gave up at 30. These bound it.
#
# RPC_TIMEOUT_MS      hard bound on one API-path RPC call (250-60000)
# RPC_MAX_ATTEMPTS    total HTTP attempts per call; 1 disables ethers' retries
#                     and leaves retrying to the indexer, which backs off
RPC_TIMEOUT_MS=8000
RPC_MAX_ATTEMPTS=1

# --- Indexer ----------------------------------------------------------------
# WEB3_INDEXER_CHUNK_SIZE       largest eth_getLogs range to attempt. Halved
#                               automatically when a provider refuses the range,
#                               and grown back after three clean chunks, so this
#                               is an upper bound rather than a promise.
# WEB3_INDEXER_MIN_CHUNK_SIZE   floor for that adaptation (clamped to the
#                               chunk size when set larger)
# WEB3_INDEXER_POLL_MS          delay after a pass that reached the head
# WEB3_INDEXER_CATCHUP_POLL_MS  delay after a pass that is still behind
# WEB3_INDEXER_CHUNK_DELAY_MS   pause between chunks, so a backlog leaves the
#                               shared RPC some capacity for the API
# WEB3_INDEXER_MAX_BLOCKS_PER_PASS  blocks per pass; 0 disables the cap
# WEB3_INDEXER_RPC_TIMEOUT_MS   per-call bound for the indexer. Higher than the
#                               API's: a wide eth_getLogs is legitimately slower
#                               than a balance read.
# WEB3_INDEXER_MAX_ATTEMPTS     attempts per chunk before the pass gives up
# WEB3_INDEXER_BACKOFF_MS       first backoff delay; doubles per attempt
# WEB3_INDEXER_BACKOFF_MAX_MS   cap on that backoff
WEB3_INDEXER_CONFIRMATIONS=6
WEB3_INDEXER_CHUNK_SIZE=2000
WEB3_INDEXER_MIN_CHUNK_SIZE=25
WEB3_INDEXER_POLL_MS=60000
WEB3_INDEXER_CATCHUP_POLL_MS=2000
WEB3_INDEXER_CHUNK_DELAY_MS=250
WEB3_INDEXER_MAX_BLOCKS_PER_PASS=5000
WEB3_INDEXER_RPC_TIMEOUT_MS=20000
WEB3_INDEXER_MAX_ATTEMPTS=4
WEB3_INDEXER_BACKOFF_MS=2000
WEB3_INDEXER_BACKOFF_MAX_MS=300000
WEB3_INDEXER_REORG_DEPTH=24

# --- Read-only API ----------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://flo-portfolio.com,https://web3.flo-portfolio.com
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW=1 minute
API_STALE_AFTER_SECONDS=300

# Snapshot cache. One refresh per TTL, shared by every concurrent caller, so
# /splits, /summary and /dashboard arriving together cost one set of chain reads
# rather than three.
#
# API_SNAPSHOT_TTL_SECONDS          how long a snapshot is served as current
# API_SNAPSHOT_MAX_STALE_SECONDS    oldest snapshot still served — clearly
#                                   labelled stale — when a refresh fails
# API_CHAIN_HEAD_TTL_SECONDS        cache for the latest block, shared with
#                                   /health so a monitor costs no chain reads
# API_RPC_ERROR_COOLDOWN_SECONDS    quiet period after an RPC failure before
#                                   the provider is tried again
# API_HEALTH_TIMEOUT_MS             bound on every read /health performs
API_SNAPSHOT_TTL_SECONDS=60
API_SNAPSHOT_MAX_STALE_SECONDS=900
API_CHAIN_HEAD_TTL_SECONDS=15
API_RPC_ERROR_COOLDOWN_SECONDS=30
API_HEALTH_TIMEOUT_MS=2000

LOG_LEVEL=info
